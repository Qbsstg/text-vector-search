# 仅为模板。在授权主机替换全部占位值，不提交真实配置。
# APP_DATA_DIR由application.yml显式插值，必须使用绝对路径。
APP_DATA_DIR=/var/lib/vector-search/db
PORT=8080
DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
# 仅用于经回环Nginx转发的部署；直连开发不启用此配置。
SPRING_PROFILES_ACTIVE=proxy
# 通过Spring宽松绑定读取；检索许可的业务执行仍待B4。
VECTOR_WORKER_COUNT=1
VECTOR_QUEUE_CAPACITY=64
VECTOR_MAX_PENDING_TASKS=1000
VECTOR_MAX_DOCUMENTS=5000
VECTOR_SEARCH_PERMITS=1
VECTOR_MAX_TEXT_CODE_POINTS=20000
VECTOR_MAX_REQUEST_BYTES=262144
VECTOR_MAX_TOP_K=100
VECTOR_MAX_PAGE_SIZE=100
VECTOR_CPU_ROUNDS=32
VECTOR_SCAN_INTERVAL_MS=500
VECTOR_SCAN_BATCH_SIZE=32
VECTOR_SHUTDOWN_WAIT_SECONDS=30
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=45s
