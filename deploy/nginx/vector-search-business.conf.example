# 仅为未来业务代理模板，当前禁止放入sites-enabled，不据此发布应用。
# 启用前须验收B3/B4、真实浏览器、回滚、Origin可信代理与入口认证。
# 入口凭据由操作者安全创建，不能写入仓库、前端或对话。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name text-vector-search.lemoncharger.com;
    server_tokens off;
    ssl_certificate /etc/vector-search/tls/20261023/fullchain.pem;
    ssl_certificate_key /etc/vector-search/tls/20261023/privatekey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 256k;
    auth_basic "Vector search";
    auth_basic_user_file /etc/nginx/vector-search.htpasswd;

    if ($host != text-vector-search.lemoncharger.com) { return 404; }
    location = /health { return 404; }
    location ~ ^/(actuator|h2-console)(/|$) { return 404; }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # 覆盖客户端转发头；不追加伪造来源，也不透传客户端Forwarded。
        proxy_set_header Host text-vector-search.lemoncharger.com;
        proxy_set_header X-Forwarded-Host text-vector-search.lemoncharger.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        # Basic认证仅用于入口，不将其凭据继续传给应用。
        proxy_set_header Authorization "";
        # 提交和搜索可能写入数据库，禁止代理自动重放。
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
