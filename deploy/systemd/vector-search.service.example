# 仅为模板：替换@SERVICE_USER@、@SERVICE_GROUP@和@JAVA17@。
# 路径为建议，不表示资源已经存在。
[Unit]
Description=Vector search single-instance application
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=/var/lib/vector-search
EnvironmentFile=/etc/vector-search/app.env
ExecStart=@JAVA17@ -Xms256m -Xmx1024m -jar /opt/vector-search/current/app.jar
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
# 120s为临时外层预算，不是实测关闭时限保证。
# Spring的45s按每阶段计算，须根据实际生命周期阶段重新评估。
TimeoutStopSec=120s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vector-search/db
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vector-search

[Install]
WantedBy=multi-user.target
