# 仅为模板：替换@SERVICE_USER@、@SERVICE_GROUP@和@JAVA17@。
# 路径为建议，不表示资源已经存在。
[Unit]
Description=Vector search single-instance application
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=/var/lib/vector-search
EnvironmentFile=/etc/vector-search/app.env
# flock保留同一Java主进程身份；锁文件须预建且永不随stop/start删除，H2原生锁仍保留。
ExecStartPre=/usr/bin/test -f /var/lib/vector-search/db/.instance.lock
ExecStart=/usr/bin/flock --exclusive --nonblock --no-fork /var/lib/vector-search/db/.instance.lock @JAVA17@ -Xms256m -Xmx1024m -jar /opt/vector-search/current/app.jar --spring.profiles.active=proxy
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
# Java可完成Spring/Hikari优雅关闭后退出143；将其列为预期状态，避免误报failed。
# 这不代替真实关闭日志、进程退出及H2无占用检查，其他错误仍按失败处理。
SuccessExitStatus=143
# 120s为临时外层预算，不是实测关闭时限保证。
# Spring的45s按每阶段计算，须根据实际生命周期阶段重新评估。
TimeoutStopSec=120s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vector-search/db
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vector-search

[Install]
WantedBy=multi-user.target
