{
  "schema_version": 1,
  "task": "FINAL-QUALITY",
  "status": "NOT_RUN",
  "description": "仅用例定义，不含网络执行器。未获主控GO不得执行。",
  "contract": "api-v1.0/runtime-v1.0",
  "configuration": {
    "base_url_env": "QUALITY_BASE_URL",
    "credentials_env": "QUALITY_CREDENTIALS_FILE",
    "credentials_policy": "仅0600受限文件或安全进程环境；不输出值、Authorization、Cookie、私钥；URL禁止userinfo；TLS必须校验；禁止重定向携带认证",
    "run_prefix_env": "QUALITY_RUN_PREFIX",
    "channel_env": "QUALITY_CHANNEL",
    "run_id_policy": "每轮唯一ASCII安全前缀和精确渠道；拒绝复用已存在渠道；fixture ID只在同轮复用",
    "input_validation": "执行前强制校验HTTPS且无userinfo、非空唯一RUN_PREFIX、CHANNEL精确非空且<=55码点以容纳后缀、ID长度<=128；任何缺失或模板未展开立即拒绝。认证材料不得放URL或CLI参数。"
  },
  "budget": {
    "successful_new_documents": 12,
    "whole_round_successful_documents": 20,
    "total_http_requests": 240,
    "submit_attempts": 32,
    "search_attempts": 16,
    "invalidation_attempts": 4,
    "get_attempts": 180,
    "global_get_rps": 4,
    "automatic_retries": 0,
    "request_timeout_seconds": 10
  },
  "safety": {
    "preflight_required": [
      "主控书面GO",
      "JAR摘要与批准值一致",
      "businessReady=true",
      "剩余容量>=本轮剩余预算",
      "统一全轮预算账本和已有写入扣账",
      "与k6/Chrome串行或统一调度",
      "精确channel预检为空"
    ],
    "stop_on": [
      "网络超时/断连",
      "RESULT_UNKNOWN",
      "非JSON业务写响应且结果未知",
      "任务FAILED或轮询预算耗尽",
      "版本不符",
      "非READY",
      "异常5xx",
      "资源安全阈值触发",
      "任何预算不足"
    ],
    "unknown_policy": "立即停止全部后续业务写入，包含搜索；仅主控批准诊断GET，不重发原请求，不用累计hitCount推断未知提交。",
    "ledger_policy": "发出请求前先原子扣账，失败/429/超时也消耗预算；所有子请求包括轮询/重定向均计入，禁自动重定向。替代fixture操作不得重复执行。",
    "scope": "仅本轮合成文档；禁止删除/覆盖/停机/故障注入/无channel搜索",
    "performance_coordination": "用户已批准主控正式服务1/2/4/8并发，每阶30秒总窗口<=120秒；功能与压测分阶段计数，不共享16次功能搜索预算。主控统一总账，QA不自行执行。"
  },
  "event_schema": {
    "required": [
      "run_id",
      "case_id",
      "request_ordinal",
      "method",
      "route_template",
      "start_utc",
      "duration_ms",
      "http_status",
      "actual_code",
      "outcome",
      "budget_remaining"
    ],
    "optional": [
      "task_state",
      "safe_document_alias",
      "hit_aliases",
      "hit_scores",
      "expected_match",
      "response_body_sha256"
    ],
    "redaction": "不记请求/响应原文、完整URL查询、认证头、Cookie、内部路径。错误message只保留摘要散列。真实code不可改成预期code。"
  },
  "polling": {
    "max_total": 120,
    "max_per_task": 10,
    "interval_seconds": 2,
    "deadline_seconds": 30,
    "terminal_states": [
      "SUCCEEDED",
      "FAILED"
    ],
    "note": "轮询间隔只控制负载；不能用sleep证明异步/竞态正确性。"
  },
